# Public site origin for SEO (sitemap, Open Graph, canonical URLs).
#
# Local development:
#   NEXT_PUBLIC_SITE_URL=http://localhost:3000
#
# Production (set this in your host’s environment for Googie Tools 1.0):
#   NEXT_PUBLIC_SITE_URL=https://googietools.com
#
# If unset, the app falls back to https://googietools.com.
NEXT_PUBLIC_SITE_URL=https://googietools.com
